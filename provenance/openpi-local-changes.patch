+def log_parameter_summary(config: _config.TrainConfig, params: nnx.State) -> dict[str, int]:
+    """Report optimizer-selected parameters using shapes only (no device transfers)."""
+    all_params = traverse_util.flatten_dict(params.filter(nnx.Param).to_pure_dict())
+    trainable = traverse_util.flatten_dict(params.filter(config.trainable_filter).to_pure_dict())
+
+    def count(tree, predicate=lambda path: True):
+        return sum(int(np.prod(value.shape)) for path, value in tree.items() if predicate(path))
+
+    def is_lora(path):
+        return any("lora" in str(part).lower() for part in path)
+
+    groups = {
+        "Vision backbone": lambda path: path[:2] == ("PaliGemma", "img"),
+        "Gemma original weights": lambda path: path[:2] == ("PaliGemma", "llm") and not is_lora(path),
+        "LoRA adapters": is_lora,
+    }
+    total = count(all_params)
+    updated = count(trainable)
+    lora_updated = count(trainable, is_lora)
+    lines = [
+        "Parameter summary (optimizer selection; before training)",
+        f"  Total model parameters:     {total:,}",
+        f"  Trainable parameters:       {updated:,} ({100 * updated / max(total, 1):.2f}%)",
+        f"  Frozen parameters:          {total - updated:,}",
+        f"  Trainable LoRA parameters:  {lora_updated:,}",
+        f"  Trainable non-LoRA params:  {updated - lora_updated:,}",
+    ]
+    for label, predicate in groups.items():
+        group_total = count(all_params, predicate)
+        group_updated = count(trainable, predicate)
+        if group_total == 0:
+            status = "NOT PRESENT"
+        elif group_updated == 0:
+            status = "FROZEN"
+        elif group_updated == group_total:
+            status = "TRAINABLE"
+        else:
+            status = "PARTIALLY TRAINABLE"
+        lines.append(f"  {label}: {status} ({group_updated:,} / {group_total:,} trainable)")
+    lines.append("  Counts include adapters, exclude optimizer state and EMA copies.")
+    lines.append("  Trainable means eligible for optimizer updates; individual gradients may be zero.")
+    logging.info("\n" + "\n".join(lines))
+    return {"total": total, "trainable": updated, "frozen": total - updated, "lora_trainable": lora_updated}
+
+
