index 1d1cc9d..b161482 100644
--- a/src/openpi/training/optimizer.py
+++ b/src/openpi/training/optimizer.py
@@ -20,8 +20,22 @@ class CosineDecaySchedule(LRScheduleConfig):
     peak_lr: float = 2.5e-5
     decay_steps: int = 30_000
     decay_lr: float = 2.5e-6
+    # Optional global optimizer step at which to restart cosine decay on resume.
+    # None preserves the original warmup/cosine behavior for all existing runs.
+    restart_step: int | None = None
 
     def create(self) -> optax.Schedule:
+        if self.restart_step is not None:
+            if self.warmup_steps != 0:
+                raise ValueError("Cosine restart requires warmup_steps=0")
+            if not 0 <= self.restart_step < self.decay_steps:
+                raise ValueError("restart_step must be >= 0 and < decay_steps")
+            schedule = optax.cosine_decay_schedule(
+                init_value=self.peak_lr,
+                decay_steps=self.decay_steps - self.restart_step,
+                alpha=self.decay_lr / self.peak_lr,
+            )
+            return lambda step: schedule(jnp.maximum(0, step - self.restart_step))
         return optax.warmup_cosine_decay_schedule(
             init_value=self.peak_lr / (self.warmup_steps + 1),
             peak_value=self.peak_lr,
